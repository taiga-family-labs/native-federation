{
  "name": "native-federation-taiga-demo",
  "private": true,
  "version": "0.0.3",
  "description": "Angular + Taiga UI + Native Federation demo with host and two child apps.",
  "scripts": {
    "start:host": "ng serve host --port 4200",
    "start:products": "ng serve child-products --port 4201",
    "start:profile": "ng serve child-profile --port 4202",
    "build:host": "ng build host",
    "build:products": "ng build child-products",
    "build:profile": "ng build child-profile",
    "build": "npm run build:products && npm run build:profile && npm run build:host",
    "e2e": "playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular-architects/native-federation": "^19.0.0",
    "@taiga-ui/core": "^4.0.0",
    "@taiga-ui/icons": "^4.0.0",
    "@taiga-ui/kit": "^4.0.0",
    "rxjs": "^7.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@playwright/test": "^1.52.0",
    "@taiga-ui/configs": "^4.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3"
  }
}
